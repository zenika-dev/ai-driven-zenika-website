---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, getPage } from '../../i18n/utils';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.params;
const { title, description } = await getPage(lang, 'publications');
---

<BaseLayout title={title} description={description} locale={lang}>
  <section class="section">
    <div class="container">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </section>
</BaseLayout>
