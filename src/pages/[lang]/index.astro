---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Clients from '../../components/sections/Clients.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import Hero from '../../components/sections/Hero.astro';
import Methodology from '../../components/sections/Methodology.astro';
import Publications from '../../components/sections/Publications.astro';
import Services from '../../components/sections/Services.astro';
import Values from '../../components/sections/Values.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ctaPage, pagePath } from '../../i18n/routes';
import { getContact, getLocalePaths, getPresentation, t } from '../../i18n/utils';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.params;
const tr = t(lang);
const { title, description, presentation } = await getPresentation(lang);
const { contact } = await getContact(lang);
const { hero, values, services, methodology, clients, publications } = presentation;
const messages = {
  required: tr('form.required'),
  invalidEmail: tr('form.invalidEmail'),
};
---

<BaseLayout title={title} description={description} locale={lang}>
  <Hero
    {...hero}
    primaryCta={{ label: hero.primaryCta, href: getRelativeLocaleUrl(lang, pagePath(ctaPage)) }}
    secondaryCta={{ label: hero.secondaryCta, href: '#values' }}
  />
  <Values {...values} />
  <Services {...services} />
  <Methodology {...methodology} />
  <Clients {...clients} />
  <Publications {...publications} />
  <ContactCta
    {...contact}
    email={tr('contact.email')}
    emailLabel={tr('contact.emailLabel')}
    messages={messages}
  />
</BaseLayout>
