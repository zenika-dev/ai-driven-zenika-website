---
import ContactCta from '../../components/sections/ContactCta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContact, getLocalePaths, t } from '../../i18n/utils';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.params;
const tr = t(lang);
const { title, description, contact } = await getContact(lang);
---

<BaseLayout title={title} description={description} locale={lang}>
  <ContactCta
    {...contact}
    email={tr('contact.email')}
    emailLabel={tr('contact.emailLabel')}
    level={1}
    tone="default"
  />
</BaseLayout>
