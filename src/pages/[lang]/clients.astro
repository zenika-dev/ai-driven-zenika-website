---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, getPage } from '../../i18n/utils';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.params;
const { title, description } = await getPage(lang, 'clients');
---

<BaseLayout title={title} description={description} locale={lang}>
  <h1>{title}</h1>
  <p>{description}</p>
</BaseLayout>
