---
/** Tinted category label. The text carries the meaning; colour only reinforces it. */
interface Props {
  text: string;
  tone: 'brand' | 'teal' | 'indigo';
}

const { text, tone } = Astro.props;
---

<span class:list={['badge', tone]}>{text}</span>

<style>
  .badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .brand {
    background: var(--color-tint-brand);
    color: var(--color-tint-brand-text);
  }

  .teal {
    background: var(--color-tint-teal);
    color: var(--color-tint-teal-text);
  }

  .indigo {
    background: var(--color-tint-indigo);
    color: var(--color-tint-indigo-text);
  }
</style>
