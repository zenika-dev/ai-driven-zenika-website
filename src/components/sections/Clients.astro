---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  names: string[];
}

const { eyebrow, heading, intro, names } = Astro.props;
---

<section id="clients" class="section" aria-labelledby="clients-title">
  <div class="container">
    <SectionHeading id="clients-title" eyebrow={eyebrow} heading={heading} intro={intro} />
    <!-- Client names as text chips, as in the design; logos come from Figma later. -->
    <div class="marquee">
      <div class="track">
        <ul class="logos">
          {names.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
        <!-- Second copy makes the loop seamless; hidden from assistive technology. -->
        <ul class="logos" aria-hidden="true">
          {names.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    padding: var(--space-4);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .track {
    display: flex;
    width: max-content;
  }

  .logos {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-4);
    margin: 0;
    padding: 0 var(--space-2) 0 0;
    list-style: none;
  }

  .logos li {
    display: grid;
    place-items: center;
    min-width: 9.375rem;
    min-height: 3.125rem;
    padding: var(--space-1) var(--space-4);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: scroll 30s linear infinite;
    }

    .marquee:hover .track {
      animation-play-state: paused;
    }
  }

  /* Reduced motion: no scrolling, a single wrapped row of chips instead. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      width: auto;
    }

    .logos {
      flex-wrap: wrap;
    }

    .logos[aria-hidden='true'] {
      display: none;
    }
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
