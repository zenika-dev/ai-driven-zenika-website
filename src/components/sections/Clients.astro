---
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow: string;
  heading: string;
  points: string[];
  names: string[];
}

const { eyebrow, heading, points, names } = Astro.props;
---

<section id="clients" class="section" aria-labelledby="clients-title">
  <div class="container">
    <div class="grid">
      <div>
        <Eyebrow text={eyebrow} />
        <h2 id="clients-title">{heading}</h2>
      </div>
      <ul class="points">
        {points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
    <!-- Client names as text chips, as in the design; logos come from Figma later. -->
    <ul class="logos">
      {names.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-5) var(--space-8);
    margin-block-end: var(--heading-gap);
  }

  h2 {
    max-width: 9.5em;
    margin: 0;
  }

  .points {
    margin: 0;
    padding-inline-start: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: var(--line-height-base);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4);
    list-style: none;
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .logos li {
    display: grid;
    place-items: center;
    min-width: 9.375rem;
    min-height: 3.125rem;
    padding: var(--space-1) var(--space-4);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .logos li {
      flex: 1 1 calc(50% - var(--space-4));
      min-width: 0;
    }
  }

  /* Heading block centred against the list, as in the laptop frame. */
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 33rem;
      align-items: center;
    }
  }
</style>
