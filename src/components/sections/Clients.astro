---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  names: string[];
}

const { eyebrow, heading, intro, names } = Astro.props;
---

<section id="clients" class="section section--alt" aria-labelledby="clients-title">
  <div class="container">
    <SectionHeading id="clients-title" eyebrow={eyebrow} heading={heading} intro={intro} />
    <!-- Client names as text chips, as in the mockup; logos come from Figma later. -->
    <ul class="logos">
      {names.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    list-style: none;
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  li {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
