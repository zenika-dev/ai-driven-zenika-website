---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Highlight from '../ui/Highlight.astro';

interface Props {
  label: string;
  heading: string;
  highlight: string;
  intro: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  image: ImageMetadata;
  imageAlt: string;
}

const { label, heading, highlight, intro, primaryCta, secondaryCta, image, imageAlt } = Astro.props;
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="label">{label}</p>
      <h1 id="hero-title">
        <Highlight text={heading} highlight={highlight} />
      </h1>
      <p class="intro">{intro}</p>
      <div class="actions">
        <Button href={primaryCta.href} variant="dark" class="primary-cta">
          {primaryCta.label}
        </Button>
        <Button href={secondaryCta.href} variant="ghost">
          {secondaryCta.label}
        </Button>
      </div>
    </div>
    <Image
      src={image}
      alt={imageAlt}
      class="media"
      widths={[480, 800, 1232]}
      sizes="(min-width: 1024px) 45vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--section-padding);
  }

  .grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .label {
    margin: 0 0 var(--space-5);
    color: var(--color-brand-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: var(--space-5);
  }

  .intro {
    max-width: 32rem;
    margin-block-end: var(--space-6);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }

  .media {
    width: 100%;
    height: auto;
    aspect-ratio: 6 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 1023px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.primary-cta) {
      display: flex;
      width: 100%;
    }

    .media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
