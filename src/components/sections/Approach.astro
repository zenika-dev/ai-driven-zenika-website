---
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow: string;
  heading: string;
  commitments: string[];
}

const { eyebrow, heading, commitments } = Astro.props;
---

<section id="approach" class="section" aria-labelledby="approach-title">
  <div class="container grid">
    <div>
      <Eyebrow text={eyebrow} />
      <h2 id="approach-title">{heading}</h2>
    </div>
    <ol class="commitments">
      {commitments.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-6) var(--space-8);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-display);
    line-height: 1.15;
  }

  .commitments {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: commitment;
  }

  .commitments li {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block-end: var(--border-width) solid var(--color-border);
    font-family: var(--font-family-display);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    counter-increment: commitment;
  }

  .commitments li:first-child {
    padding-block-start: var(--space-2);
  }

  .commitments li:last-child {
    border-block-end: 0;
  }

  .commitments li::before {
    content: counter(commitment, decimal-leading-zero);
    min-width: 1.5rem;
    color: var(--color-brand-text);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  /* Two columns from tablet up, as in the 834px frame. */
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 35.25rem;
    }

    .commitments {
      padding-block-start: var(--space-5);
    }

    .commitments li {
      font-size: var(--font-size-lg);
    }
  }
</style>
