---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  items: { kind: string; title: string }[];
}

const { eyebrow, heading, intro, items } = Astro.props;
const gradients = ['orange', 'purple', 'blue'] as const;
---

<section id="publications" class="section section--alt" aria-labelledby="publications-title">
  <div class="container">
    <SectionHeading id="publications-title" eyebrow={eyebrow} heading={heading} intro={intro} />
    <!-- Not links in the MVP: the Publications page is hidden. -->
    <ul class="cards">
      {items.map(({ kind, title }, i) => (
        <li class:list={['card', gradients[i % gradients.length]]}>
          <p class="kind">{kind}</p>
          <h3>{title}</h3>
          <span class="arrow">
            <Icon name="arrow-up-right" />
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    min-height: 20rem;
    padding: var(--space-6);
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  /* Decorative "Z" watermark (pseudo-element, so it is not read or contrast-checked). */
  .card::after {
    content: 'Z';
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0.05em;
    color: var(--color-watermark);
    font-family: var(--font-family-display);
    font-size: 11rem;
    font-weight: var(--font-weight-black);
    line-height: 1;
    pointer-events: none;
  }

  /* Decorative arrow, as on the expertise "Découvrir" buttons. Not a link in the MVP. */
  .arrow {
    position: absolute;
    inset-inline-end: var(--space-5);
    inset-block-end: var(--space-5);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--color-on-brand);
    color: var(--brand-ink);
  }

  /* Text colours are fixed per gradient (not themed) so contrast holds in both themes. */
  .orange {
    background: var(--gradient-orange);
    color: var(--brand-ink);
  }

  .purple {
    background: var(--gradient-purple);
    color: var(--color-on-brand);
  }

  .blue {
    background: var(--gradient-blue);
    color: var(--brand-ink);
  }

  .kind {
    margin: 0 0 var(--space-7);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--font-size-card-title);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--tracking-tight);
  }

  /* Tablet: two cards side by side, the third full width (834px frame). */
  @media (min-width: 640px) and (max-width: 1023px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
