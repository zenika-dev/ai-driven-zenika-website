---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ctaPage, pagePath } from '../../i18n/routes';
import { t } from '../../i18n/utils';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = t(locale);
const ctaHref = getRelativeLocaleUrl(locale, pagePath(ctaPage));
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={getRelativeLocaleUrl(locale)}>
      <Logo alt={tr('site.name')} />
    </a>
    <Nav locale={locale} />
    <div class="tools">
      <LanguageSwitcher locale={locale} />
      <Button
        href={ctaHref}
        size="sm"
        aria-current={Astro.url.pathname === ctaHref ? 'page' : undefined}
      >
        <span class="cta-long">{tr('header.cta')}</span>
        <span class="cta-short">{tr('header.ctaShort')}</span>
      </Button>
      <ThemeToggle label={tr('theme.toggle')} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    background: var(--color-bg);
    border-block-end: var(--border-width) solid var(--color-border);
    /* Shared between pages, so it stays in place during page transitions. */
    view-transition-name: site-header;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    min-height: var(--header-height);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .cta-long {
    display: none;
  }

  @media (min-width: 640px) {
    .inner {
      column-gap: var(--space-6);
    }

    .tools {
      gap: var(--space-3);
    }

    .cta-long {
      display: inline;
    }

    .cta-short {
      display: none;
    }
  }
</style>
