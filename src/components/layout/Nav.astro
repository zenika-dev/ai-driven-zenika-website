---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { navSections, pagePath } from '../../i18n/routes';
import { t } from '../../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = t(locale);
const home = getRelativeLocaleUrl(locale, pagePath('index'));
// Sections of the home page, so from any other page these links lead back to it.
const items = navSections.map((id) => ({ href: `${home}#${id}`, label: tr(`nav.${id}`) }));
---

<nav class="main-nav" aria-label={tr('nav.label')}>
  <ul>
    {items.map(({ href, label }) => (
      <li>
        <a href={href}>{label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Below 640px the logo is the home link and the CTA reaches Contact, as in the mockup. */
  .main-nav {
    display: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-brand-text);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  @media (min-width: 640px) {
    .main-nav {
      display: block;
    }
  }
</style>
