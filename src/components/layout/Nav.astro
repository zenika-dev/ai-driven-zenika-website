---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { navPages, pagePath } from '../../i18n/routes';
import { t } from '../../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = t(locale);
const items = navPages.map((page) => {
  const href = getRelativeLocaleUrl(locale, pagePath(page));
  return { href, label: tr(`nav.${page}`), current: Astro.url.pathname === href };
});
---

<nav aria-label={tr('nav.label')}>
  <ul>
    {items.map(({ href, label, current }) => (
      <li>
        <a href={href} aria-current={current ? 'page' : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    text-decoration: underline;
  }
</style>
