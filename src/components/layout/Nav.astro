---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { navPages, navSections, pagePath } from '../../i18n/routes';
import { t } from '../../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = t(locale);
const home = getRelativeLocaleUrl(locale, pagePath('index'));
const pageItems = navPages.map((page) => {
  const href = getRelativeLocaleUrl(locale, pagePath(page));
  return { href, label: tr(`nav.${page}`), current: Astro.url.pathname === href };
});
// Sections of the home page, so from any other page these links lead back to it.
const sectionItems = navSections.map((id) => ({
  href: `${home}#${id}`,
  label: tr(`nav.${id}`),
  current: false,
}));
const items = [...pageItems, ...sectionItems];
---

<nav class="main-nav" aria-label={tr('nav.label')}>
  <ul>
    {items.map(({ href, label, current }) => (
      <li>
        <a href={href} aria-current={current ? 'page' : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-brand-text);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  @media (min-width: 640px) {
    ul {
      gap: var(--space-2) var(--space-5);
    }
  }
</style>
